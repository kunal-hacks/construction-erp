{
  "expo": {
    "name": "Construction ERP",
    "slug": "construction-erp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.constructionerp.app",
      "buildNumber": "1"
    },
    "android": {
     
      "package": "com.constructionerp.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      
      "expo-secure-store",
      [
        "expo-camera",
        { "cameraPermission": "Allow Construction ERP to access your camera." }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Allow Construction ERP to access your photos." }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ]
    ],
    
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}

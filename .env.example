# Construction ERP — Environment Variables Template
# Copy this file to .env and fill in your values

# JWT Secrets (REQUIRED — use strong random strings)
JWT_SECRET=CHANGE_ME_min_32_characters_random_string_here
JWT_REFRESH_SECRET=CHANGE_ME_another_min_32_chars_random_string

# Application URLs
FRONTEND_URL=http://localhost
VITE_API_URL=http://localhost/api/v1
CORS_ORIGINS=http://localhost,http://localhost:3001

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Domain (for production SSL)
DOMAIN=localhost
